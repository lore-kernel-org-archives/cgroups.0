+		  MEMCOMP_RECLAIM_DIRECT, 1, "lz4-generic", false },
+	};
+	struct memcomp_reclaim_ctx *ctx;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
