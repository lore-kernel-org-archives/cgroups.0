+	f->refs->compressed_before = atomic64_read(&memcomp_compressed_bytes);
+#ifdef CONFIG_MEMCOMP_DEBUG_STATS
+	f->refs->pending_before = atomic64_read(&memcomp_pending_pages);
+#endif
