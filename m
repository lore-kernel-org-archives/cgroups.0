+static bool memcomp_test_user_intact(unsigned long addr)
+{
+	unsigned long val;
+	unsigned int i;
+
+	for (i = 0; i < PAGE_SIZE / sizeof(val); i++) {
+		if (get_user(val, (unsigned long __user *)addr + i))
+			return false;
+		if (val != MEMCOMP_TEST_USER_PATTERN + i)
+			return false;
+	}
+	return true;
+}
