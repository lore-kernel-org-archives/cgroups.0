+static void memcomp_test_zero_load_changed(struct kunit *test)
+{
+	struct mc16_zl_mm *f = mc16_zl_begin(test);
+	pte_t orig = mc16_zl_zero_pte();
+	pte_t changed = pte_swp_mkexclusive(orig);
