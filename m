+	KUNIT_EXPECT_EQ(f->test, mc16_flt_rss(f, MM_SWAPENTS), f->swapents);
+	KUNIT_EXPECT_EQ(f->test, mc16_flt_rss(f, MM_ANONPAGES), f->anonpages);
+	mmput(f->mm);
