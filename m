+	mc16_test_zcall_counts(f, 1, 3);
+	memcomp_invalidate_cache(0);
+	mc16_test_zcall_counts(f, 1, 2);
+	mc16_zero_diagnostics_read(&after);
+	memcomp_invalidate_nr(0, 0);
