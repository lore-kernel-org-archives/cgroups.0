+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_RESIDENT_TEST_H
+#define _MM_MEMCOMP_TESTS_RESIDENT_TEST_H
+
+#include <kunit/resource.h>
