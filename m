+		[MC16_META_SEGMENT] = 8,
+		[MC16_META_CLUSTER] = 1,
+		[MC16_META_KEY] = 1,
+		[MC16_META_DESCRIPTOR] = 8,
+		[MC16_META_SHADOW] = 8,
+	};
+#endif
+	unsigned int i;
+	u8 *src;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, f);
