+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_SHMEM_RETRY_TEST_H
+#define _MM_MEMCOMP_TESTS_SHMEM_RETRY_TEST_H
+
+/*
+ * Include after cache_folio_test.h in suite.h. CONFIG_SHMEM gates the cases.
+ * The CONFIG_MEMCOMP_KUNIT_TEST entry seam in mc16_cache_load() observes
+ * the real consumer before its publication-window check.
+ *
+ * A real shmem file is populated and evicted through its writepage operation.
+ * The existing eviction stub computes a native shadow but delays visibility
+ * by leaving the PUBLISHING marker. The load observer calls the original
+ * consumer, records its actual -EAGAIN, then completes native publication.
+ * Only shmem's real outer loop can retry; no retry/error translation is
+ * implemented here. This is a scheduled window, not a concurrent stress test.
+ * A direct preflight checks the seam before entering a potentially repeating
+ * outer call, so forgetting the new seam fails rather than hangs the suite.
+ */
+#ifdef CONFIG_SHMEM
+#define MC16_SHMEM_RETRY_TEST_ENABLED
+
+#include <kunit/static_stub.h>
+#include <linux/file.h>
+#include <linux/shmem_fs.h>
+#include <linux/writeback.h>
+
+struct mc16_sr_test {
+	struct kunit *test;
+	struct mc16_cf_test *cache;
+	struct file *file;
+	struct folio *probe;
+	struct folio *result;
+	void *entry;
+	void *shadow;
+	unsigned int evictions;
+	unsigned int calls;
+	unsigned int reads;
+	unsigned int refs[2];
+	int errors[2];
+	int read_error;
+	bool isolated;
+	bool preflight;
+	bool published;
+	bool contract;
+	bool result_locked;
+	bool result_uptodate;
+	bool result_mapping;
+	bool result_bytes;
+};
+
+static struct mc16_sr_test *mc16_sr_current;
+
+static u64 mc16_sr_shadow(struct memcomp_ref *ref)
+{
+	u64 word;
+
+	mutex_lock(memcomp_lock_of(ref->token));
+	word = *mc16_shadow_ptr(ref);
+	mutex_unlock(memcomp_lock_of(ref->token));
+	return word;
+}
+
+static void mc16_sr_cleanup(void *data)
+{
+	struct mc16_sr_test *f = data;
+
+	mc16_sr_current = NULL;
+	mc16_cf_actor = NULL;
+	f->cache->probe.task = current;
+	f->cache->payload.task = current;
+#ifdef CONFIG_MEMCG
+	f->cache->model.task = current;
+#endif
+	if (f->result) {
+		if (folio_test_locked(f->result))
+			folio_unlock(f->result);
+		folio_put(f->result);
+	}
+	if (f->probe)
+		folio_put(f->probe);
+	if (folio_test_locked(f->cache->src))
+		folio_unlock(f->cache->src);
+	if (f->isolated)
+		folio_putback_lru(f->cache->src);
+	if (f->file) {
+		/* Synchronous truncate drops the cache owner before cf cleanup. */
+		shmem_truncate_range(file_inode(f->file), 0, (loff_t)-1);
+		fput(f->file);
+	}
+	f->cache->src->swap.val = 0;
+}
+
+static void *mc16_sr_eviction(struct folio *folio,
+			      struct mem_cgroup *target_memcg)
+{
+	struct mc16_sr_test *f = mc16_sr_current;
+
+	f->evictions++;
+	f->contract &= folio == f->cache->src && folio_test_locked(folio) &&
+		!folio_test_lru(folio);
+	kunit_deactivate_static_stub(f->test, mc16_store_eviction);
+	f->shadow = mc16_store_eviction(folio, target_memcg);
+	/* Retain the actual publication gate until a reader observes it. */
+	return (void *)(unsigned long)MC16_SHADOW_PUBLISHING;
+}
+
+static int mc16_sr_read(struct memcomp_ref *ref, void *dst)
+{
+	struct mc16_sr_test *f = mc16_sr_current;
+	int ret;
+
+	f->reads++;
+	if (f->read_error && f->reads == 1)
+		return f->read_error;
+	kunit_deactivate_static_stub(f->test, mc16_load_page);
+	ret = mc16_load_page(ref, dst);
+	kunit_activate_static_stub(f->test, mc16_load_page, mc16_sr_read);
+	return ret;
+}
+
+static int mc16_sr_load(struct memcomp_ref *ref, struct folio *folio)
+{
+	struct mc16_sr_test *f = mc16_sr_current;
+	unsigned int call;
+	u64 before, after;
+	int ret;
+
+	if (f->preflight)
+		return -EINTR;
+	call = f->calls++;
+	before = mc16_sr_shadow(ref);
+	f->contract &= ref->token == f->cache->token && folio_test_locked(folio);
+	rcu_read_lock();
+	f->contract &= xa_load(&f->file->f_mapping->i_pages, 0) == f->entry;
+	rcu_read_unlock();
+	if (call < ARRAY_SIZE(f->refs))
+		f->refs[call] = refcount_read(&ref->slot->refs);
+	kunit_deactivate_static_stub(f->test, mc16_cache_load);
+	ret = mc16_cache_load(ref, folio);
+	kunit_activate_static_stub(f->test, mc16_cache_load, mc16_sr_load);
+	after = mc16_sr_shadow(ref);
+	if (call < ARRAY_SIZE(f->errors))
+		f->errors[call] = ret;
+	if (!call) {
+		f->contract &= before == MC16_SHADOW_PUBLISHING &&
+			after == MC16_SHADOW_PUBLISHING && !f->reads;
+		if (ret == -EAGAIN) {
+			/* Finish the paused publisher; do not synthesize its shadow. */
+			mc16_store_publish(ref, 1, f->shadow);
+			f->published = true;
+		}
+	} else {
+		f->contract &= before == (u64)(unsigned long)f->shadow && !after;
+	}
+	return ret;
+}
+
+static struct mc16_sr_test *mc16_sr_begin(struct kunit *test)
+{
+	struct mc16_sr_test *f;
+	struct mc16_cf_test *cache = mc16_cf_begin(test);
+
+	if (!cache)
+		return NULL;
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->cache = cache;
+	f->contract = true;
+	if (kunit_add_action_or_reset(test, mc16_sr_cleanup, f))
+		return NULL;
+	f->file = shmem_kernel_file_setup("memcomp-shmem-retry", PAGE_SIZE,
+					  VM_NORESERVE);
+	if (IS_ERR(f->file)) {
+		f->file = NULL;
+		return NULL;
+	}
+	f->probe = folio_alloc(GFP_KERNEL, 0);
+	if (!f->probe)
+		return NULL;
+	return f;
+}
+
+/* All locks and the isolate reference are released before caller assertions. */
+static int mc16_sr_pageout(struct mc16_sr_test *f)
+{
+	struct address_space *mapping = f->file->f_mapping;
+	struct writeback_control wbc = { .for_reclaim = 1 };
+	struct folio *folio = NULL;
+	int ret;
+
+	ret = shmem_get_folio(file_inode(f->file), 0, 0, &folio, SGP_CACHE);
+	if (ret)
+		return ret;
+	if (!folio || folio_test_large(folio)) {
+		if (folio) {
+			folio_unlock(folio);
+			folio_put(folio);
+		}
+		return -EINVAL;
+	}
+	folio_put(f->cache->src);
+	f->cache->src = folio;
+	f->cache->fifo_entries = atomic_long_read(&memcomp_lrus[folio_nid(folio)].nr_entries);
+#ifdef CONFIG_MEMCG
+	f->cache->model.folio = folio;
+#endif
+	mc16_cf_fill(f->cache, MC16_CF_BYTES);
+	folio_mark_uptodate(folio);
+	folio_mark_dirty(folio);
+	lru_add_drain_all();
+	if (!folio_isolate_lru(folio)) {
+		folio_unlock(folio);
+		return -EBUSY;
+	}
+	/* writepage is normally called with an inactive reclaim source. */
+	folio_clear_active(folio);
+	f->isolated = true;
+	mc16_cf_actor = f->cache;
+	ret = mapping->a_ops->writepage(&folio->page, &wbc);
+	mc16_cf_actor = NULL;
+	if (folio_test_locked(folio))
+		folio_unlock(folio);
+	if (folio->mapping)
+		folio_putback_lru(folio);
+	else
+		folio_put(folio);
+	f->isolated = false;
+	return ret;
+}
+
+static int mc16_sr_outer(struct mc16_sr_test *f)
+{
+	struct folio *folio;
+	void *src, *dst;
+	int ret;
+
+	ret = shmem_get_folio(file_inode(f->file), 0, 0, &f->result, SGP_CACHE);
+	if (ret || !f->result)
+		return ret;
+	folio = f->result;
+	f->result_locked = folio_test_locked(folio);
+	f->result_uptodate = folio_test_uptodate(folio);
+	f->result_mapping = folio->mapping == f->file->f_mapping;
+	src = kmap_local_folio(f->cache->src, 0);
+	dst = kmap_local_folio(folio, 0);
+	f->result_bytes = !memcmp(src, dst, PAGE_SIZE);
+	kunmap_local(dst);
+	kunmap_local(src);
+	if (f->result_locked)
+		folio_unlock(folio);
+	return ret;
+}
+
+static void mc16_sr_run(struct kunit *test, int error)
+{
+	struct mc16_sr_test *f = mc16_sr_begin(test);
+	struct shmem_inode_info *info;
+	struct address_space *mapping;
+	blkcnt_t blocks;
+	void *entry;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mc16_sr_current = f;
+	kunit_activate_static_stub(test, mc16_store_eviction, mc16_sr_eviction);
+	KUNIT_ASSERT_EQ(test, mc16_sr_pageout(f), 0);
+	mapping = f->file->f_mapping;
+	info = SHMEM_I(file_inode(f->file));
+	rcu_read_lock();
+	f->entry = xa_load(&mapping->i_pages, 0);
+	rcu_read_unlock();
+	KUNIT_ASSERT_TRUE(test, xa_is_value(f->entry));
+	KUNIT_ASSERT_TRUE(test, is_memcomp_entry(radix_to_swp_entry(f->entry)));
+	f->cache->token = swp_offset(radix_to_swp_entry(f->entry));
+	KUNIT_ASSERT_NE(test, f->cache->token, 0UL);
+	KUNIT_ASSERT_TRUE(test, mc16_get(f->cache->token, &f->cache->guard));
+	KUNIT_ASSERT_EQ(test, f->evictions, 1U);
+	KUNIT_ASSERT_TRUE(test, xa_is_value(f->shadow));
+	KUNIT_ASSERT_NE(test, (u64)(unsigned long)f->shadow, MC16_SHADOW_PUBLISHING);
+	KUNIT_ASSERT_EQ(test, mc16_sr_shadow(&f->cache->guard), MC16_SHADOW_PUBLISHING);
+	kunit_activate_static_stub(test, mc16_cache_load, mc16_sr_load);
+	/* Without the prerequisite seam this returns real -EAGAIN, not -EINTR. */
+	f->preflight = true;
+	folio_lock(f->probe);
+	ret = mc16_cache_load(&f->cache->guard, f->probe);
+	folio_unlock(f->probe);
+	f->preflight = false;
+	KUNIT_ASSERT_EQ(test, ret, -EINTR);
+	f->read_error = error;
+	kunit_activate_static_stub(test, mc16_load_page, mc16_sr_read);
+	blocks = file_inode(f->file)->i_blocks;
+	ret = mc16_sr_outer(f);
+	KUNIT_EXPECT_EQ(test, ret, error);
+	KUNIT_EXPECT_EQ(test, f->calls, 2U);
+	KUNIT_EXPECT_EQ(test, f->errors[0], -EAGAIN);
+	KUNIT_EXPECT_EQ(test, f->errors[1], error);
+	KUNIT_EXPECT_EQ(test, f->reads, 1U);
+	KUNIT_EXPECT_EQ(test, f->refs[0], 3U);
+	KUNIT_EXPECT_EQ(test, f->refs[1], 3U);
+	KUNIT_EXPECT_TRUE(test, f->contract);
+	KUNIT_EXPECT_TRUE(test, f->published);
+	KUNIT_EXPECT_EQ(test, mc16_sr_shadow(&f->cache->guard), 0ULL);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->cache->guard.slot->refs), error ? 2U : 1U);
+	KUNIT_EXPECT_EQ(test, file_inode(f->file)->i_blocks, blocks);
+	KUNIT_EXPECT_EQ(test, info->alloced, 1UL);
+	KUNIT_EXPECT_EQ(test, info->swapped, error ? 1UL : 0UL);
+	KUNIT_EXPECT_EQ(test, mapping->nrpages, error ? 0UL : 1UL);
+	if (error) {
+		KUNIT_EXPECT_PTR_EQ(test, f->result, NULL);
+		rcu_read_lock();
+		entry = xa_load(&mapping->i_pages, 0);
+		rcu_read_unlock();
+		KUNIT_EXPECT_PTR_EQ(test, entry, f->entry);
+	} else {
+		KUNIT_EXPECT_NOT_NULL(test, f->result);
+		KUNIT_EXPECT_TRUE(test, f->result_locked);
+		KUNIT_EXPECT_TRUE(test, f->result_uptodate);
+		KUNIT_EXPECT_TRUE(test, f->result_mapping);
+		KUNIT_EXPECT_TRUE(test, f->result_bytes);
+	}
+}
+
+static void memcomp_test_shmem_publish_retry(struct kunit *test)
+{
+	mc16_sr_run(test, 0);
+}
+
+static void memcomp_test_shmem_retry_eio(struct kunit *test)
+{
+	mc16_sr_run(test, -EIO);
+}
+
+static void memcomp_test_shmem_retry_enomem(struct kunit *test)
+{
+	mc16_sr_run(test, -ENOMEM);
+}
+#endif /* CONFIG_SHMEM */
+#endif /* _MM_MEMCOMP_TESTS_SHMEM_RETRY_TEST_H */
diff --git a/mm/memcomp/tests/shmem_zero_fault_test.h b/mm/memcomp/tests/shmem_zero_fault_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..b943d0596877406de4adbdb36d82ab632bbd338b
--- /dev/null
+++ b/mm/memcomp/tests/shmem_zero_fault_test.h
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_SHMEM_ZERO_FAULT_TEST_H
+#define _MM_MEMCOMP_TESTS_SHMEM_ZERO_FAULT_TEST_H
+
+/* Include after shmem_retry_test.h and fault_test.h in suite.h. */
+#if defined(MC16_SHMEM_RETRY_TEST_ENABLED) && \
+	defined(MC16_FAULT_MM_TEST_ENABLED)
+#define MC16_SHMEM_ZERO_FAULT_TEST_ENABLED
+
+#include <linux/pagemap.h>
+
+/* Same real writepage actor as the retry fixture, with a zero source. */
+static int mc16_sz_pageout(struct mc16_sr_test *f)
+{
+	struct address_space *mapping = f->file->f_mapping;
+	struct writeback_control wbc = { .for_reclaim = 1 };
+	struct folio *folio = NULL;
+	int ret;
+
+	ret = shmem_get_folio(file_inode(f->file), 0, 0, &folio, SGP_CACHE);
+	if (ret)
+		return ret;
+	if (!folio || folio_test_large(folio)) {
+		if (folio) {
+			folio_unlock(folio);
+			folio_put(folio);
+		}
+		return -EINVAL;
+	}
+	folio_put(f->cache->src);
+	f->cache->src = folio;
+	f->cache->fifo_entries =
+		atomic_long_read(&memcomp_lrus[folio_nid(folio)].nr_entries);
+#ifdef CONFIG_MEMCG
+	f->cache->model.folio = folio;
+#endif
+	mc16_cf_fill(f->cache, MC16_CF_ZERO);
+	folio_mark_uptodate(folio);
+	folio_mark_dirty(folio);
+	lru_add_drain_all();
+	if (!folio_isolate_lru(folio)) {
+		folio_unlock(folio);
+		return -EBUSY;
+	}
+	folio_clear_active(folio);
+	f->isolated = true;
+	mc16_cf_actor = f->cache;
+	ret = mapping->a_ops->writepage(&folio->page, &wbc);
+	mc16_cf_actor = NULL;
+	if (folio_test_locked(folio))
+		folio_unlock(folio);
+	if (folio->mapping)
+		folio_putback_lru(folio);
+	else
+		folio_put(folio);
+	f->isolated = false;
+	return ret;
+}
+
+static void memcomp_test_shmem_token0_not_major(struct kunit *test)
+{
+	struct mc16_sr_test *f = mc16_sr_begin(test);
+	struct vm_area_struct *vma;
+	struct address_space *mapping;
+	struct folio *folio;
+	unsigned long addr;
+	vm_fault_t ret = VM_FAULT_SIGBUS;
+	void *entry, *data;
+	bool mapped = false, zero;
+	bool uptodate, correct_mapping;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	mapping = f->file->f_mapping;
+	addr = kunit_vm_mmap(test, f->file, 0, PAGE_SIZE,
+			     PROT_READ | PROT_WRITE, MAP_SHARED, 0);
+	KUNIT_ASSERT_NE(test, addr, 0UL);
+	KUNIT_ASSERT_FALSE(test, IS_ERR_VALUE(addr));
+	KUNIT_ASSERT_EQ(test, mc16_sz_pageout(f), 0);
+	rcu_read_lock();
+	entry = xa_load(&mapping->i_pages, 0);
+	rcu_read_unlock();
+	KUNIT_ASSERT_TRUE(test, xa_is_value(entry));
+	KUNIT_ASSERT_TRUE(test, is_memcomp_entry(radix_to_swp_entry(entry)));
+	KUNIT_ASSERT_EQ(test, swp_offset(radix_to_swp_entry(entry)), 0UL);
+	KUNIT_ASSERT_EQ(test, mapping->nrpages, 0UL);
+
+	/* No ALLOW_RETRY: this call retains the caller's mmap read lock. */
+	mmap_read_lock(current->mm);
+	vma = vma_lookup(current->mm, addr);
+	if (vma && vma->vm_file == f->file) {
+		mapped = true;
+		ret = handle_mm_fault(vma, addr, FAULT_FLAG_WRITE, NULL);
+	}
+	mmap_read_unlock(current->mm);
+	KUNIT_ASSERT_TRUE(test, mapped);
+	kunit_info(test, "shmem token0 native fault: ret=%#x",
+		   (__force unsigned int)ret);
+	KUNIT_EXPECT_EQ(test, (__force unsigned int)(ret & VM_FAULT_MAJOR), 0U);
+	KUNIT_EXPECT_EQ(test,
+			(__force unsigned int)(ret & (VM_FAULT_ERROR | VM_FAULT_RETRY)),
+			0U);
+
+	/* Lookup only: do not allocate a replacement folio after a bad fault. */
+	folio = filemap_get_folio(mapping, 0);
+	KUNIT_ASSERT_FALSE(test, IS_ERR(folio));
+	f->result = folio;
+	folio_lock(folio);
+	uptodate = folio_test_uptodate(folio);
+	correct_mapping = folio->mapping == mapping;
+	data = kmap_local_folio(folio, 0);
+	zero = !memchr_inv(data, 0, PAGE_SIZE);
+	kunmap_local(data);
+	folio_unlock(folio);
+	KUNIT_EXPECT_TRUE(test, uptodate);
+	KUNIT_EXPECT_TRUE(test, correct_mapping);
+	KUNIT_EXPECT_TRUE(test, zero);
+	KUNIT_EXPECT_EQ(test, SHMEM_I(file_inode(f->file))->swapped, 0UL);
+	KUNIT_EXPECT_EQ(test, mapping->nrpages, 1UL);
+}
+#endif
+#endif /* _MM_MEMCOMP_TESTS_SHMEM_ZERO_FAULT_TEST_H */
diff --git a/mm/memcomp/tests/span_test.h b/mm/memcomp/tests/span_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..f062387cd5ecb894a846355b9a70e6f587472e85
--- /dev/null
+++ b/mm/memcomp/tests/span_test.h
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_SPAN_TEST_H
+#define _MM_MEMCOMP_TESTS_SPAN_TEST_H
+#ifdef CONFIG_MEMCG
+static void memcomp_test_span_geometry(struct kunit *test)
+{
+	struct mc16_test_refs *f = mc16_test_refs_begin(test);
+	struct mc16_test_storage *storage;
+	unsigned int nr, first, i, index;
+	u32 base;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	for (nr = 1; nr <= MEMCOMP_MAX_COMPRESS_PAGES; nr <<= 1) {
+		first = storage->nr;
+		KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, nr), 0);
+		for (i = 0; i < nr; i++) {
+			KUNIT_EXPECT_EQ(test, mc16_ref_geometry(&storage->refs[first + i],
+								&base, &index), nr);
+			KUNIT_EXPECT_EQ(test, base, storage->refs[first].token);
+			KUNIT_EXPECT_EQ(test, index, i);
+		}
+	}
+}
+
+static void memcomp_test_span_identity(struct kunit *test)
+{
+	struct mc16_test_refs *f = mc16_test_refs_begin(test);
+	struct memcomp_ref refs[2];
+	struct mc16_test_storage *storage;
+	unsigned int i;
+	u32 token;
+	bool found;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 2), 0);
+	token = storage->refs[0].token;
+	found = mc16_span_get(token, storage->owner->folio, 2, true, refs);
+	KUNIT_ASSERT_TRUE(test, found);
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_EQ(test, refcount_read(&refs[i].slot->refs), 2U);
+		mc16_ref_put(&refs[i]);
+	}
+	KUNIT_EXPECT_FALSE(test, mc16_span_get(token, NULL, 2, true, refs));
+	KUNIT_EXPECT_FALSE(test, mc16_span_get(token, storage->owner->folio,
+					       1, true, refs));
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_PTR_EQ(test, refs[i].slot, NULL);
+		KUNIT_EXPECT_EQ(test, refcount_read(&storage->refs[i].slot->refs), 1U);
+	}
+	/* A changed suffix must consume both temporary lookups on rejection. */
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 1, MC16_SAMEFILL), 0);
+	KUNIT_EXPECT_FALSE(test, mc16_span_get(token, storage->owner->folio,
+					       2, true, refs));
+	for (i = 0; i < 2; i++) {
+		KUNIT_EXPECT_PTR_EQ(test, refs[i].slot, NULL);
+		KUNIT_EXPECT_EQ(test, refcount_read(&storage->refs[i].slot->refs), 1U);
+	}
+	/* Valid geometry with an invalid token also clears poisoned outputs. */
+	memset(refs, 0xa5, sizeof(refs));
+	KUNIT_EXPECT_FALSE(test, mc16_span_get(0, storage->owner->folio,
+					       2, true, refs));
+	for (i = 0; i < 2; i++)
+		KUNIT_EXPECT_PTR_EQ(test, refs[i].slot, NULL);
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_payload(f, 0, MC16_SAMEFILL), 0);
+	found = mc16_span_get(token, storage->owner->folio, 2, false, refs);
+	KUNIT_ASSERT_TRUE(test, found);
+	for (i = 0; i < 2; i++)
+		mc16_ref_put(&refs[i]);
+
+	/* Remove a real suffix slot; the successful lookup prefix must unwind. */
+	KUNIT_ASSERT_TRUE(test, mc16_get(token + 1, &refs[1]));
+	found = mc16_owner_drop_folio_held(&refs[1], storage->owner->folio, 2, 1);
+	if (found)
+		storage->refs[1] = (struct memcomp_ref) { };
+	KUNIT_ASSERT_TRUE(test, found);
+	KUNIT_EXPECT_FALSE(test, mc16_span_get(token, storage->owner->folio,
+					       2, false, refs));
+	for (i = 0; i < 2; i++)
+		KUNIT_EXPECT_PTR_EQ(test, refs[i].slot, NULL);
+	KUNIT_EXPECT_EQ(test, refcount_read(&storage->refs[0].slot->refs), 1U);
+}
+
+static void memcomp_test_span_anon_vma(struct kunit *test)
+{
+	struct mc16_test_refs *f = mc16_test_refs_begin(test);
+	struct mc16_test_storage *storage;
+	struct mc16_record *record;
+	struct anon_vma *anon_vma, *taken, *again;
+	struct folio *mapped;
+	unsigned long addr;
+	struct memcomp_ref *head;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	storage = f->storage;
+	KUNIT_ASSERT_EQ(test, mc16_test_refs_reserve(f, 2), 0);
+	head = &storage->refs[0];
+	record = (void *)(unsigned long)head->slot->word;
+	mapped = memcomp_test_user_folio(test, &addr);
+	KUNIT_ASSERT_NOT_NULL(test, mapped);
+	anon_vma = folio_get_anon_vma(mapped);
+	folio_unlock(mapped);
+	folio_put(mapped);
+	KUNIT_ASSERT_NOT_NULL(test, anon_vma);
+	/* Own one real reference; the helper must transfer it without a put. */
+	record->anon_vma = anon_vma;
+	record->record_flags |= MC16_RECORD_ANON_VMA;
+	mutex_lock(memcomp_lock_of(head->token));
+	taken = mc16_span_take_anon_vma_locked(head, NULL, 2);
+	mutex_unlock(memcomp_lock_of(head->token));
+	KUNIT_EXPECT_PTR_EQ(test, taken, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, record->anon_vma, anon_vma);
+	mutex_lock(memcomp_lock_of(head->token));
+	taken = mc16_span_take_anon_vma_locked(head, storage->owner->folio, 2);
+	again = mc16_span_take_anon_vma_locked(head, storage->owner->folio, 2);
+	mutex_unlock(memcomp_lock_of(head->token));
+	KUNIT_EXPECT_PTR_EQ(test, taken, anon_vma);
+	KUNIT_EXPECT_PTR_EQ(test, again, NULL);
+	KUNIT_EXPECT_PTR_EQ(test, record->anon_vma, NULL);
+	KUNIT_EXPECT_FALSE(test, record->record_flags & MC16_RECORD_ANON_VMA);
+	/* Tests own the transferred reference even if a helper assertion fails. */
+	record->anon_vma = NULL;
+	record->record_flags &= ~MC16_RECORD_ANON_VMA;
+	put_anon_vma(anon_vma);
+}
+#endif /* CONFIG_MEMCG */
+#endif /* _MM_MEMCOMP_TESTS_SPAN_TEST_H */
diff --git a/mm/memcomp/tests/storage_fixture.h b/mm/memcomp/tests/storage_fixture.h
new file mode 100644
index 0000000000000000000000000000000000000000..c132682aadf402813b6dd6ffb0cd1701f8ff618a
--- /dev/null
+++ b/mm/memcomp/tests/storage_fixture.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_STORAGE_FIXTURE_H
+#define _MM_MEMCOMP_TESTS_STORAGE_FIXTURE_H
+
+/* Fault/ordering injection only. No operation or XA budget accounting. */
+struct mc16_storage_fixture {
+	struct task_struct *task;
+	unsigned int allocations;
+	unsigned int fail_at;
+	bool fail_descriptor;
+	bool hold_segments;
+	struct rcu_head *delayed_segments;
+	void (*allocation_window)(void *data);
+	void *window_data;
+};
+
+static struct mc16_storage_fixture __rcu *mc16_storage_fixture;
+
+static void mc16_kunit_queue_rcu(struct rcu_head *head, rcu_callback_t func)
+{
+	struct mc16_storage_fixture *probe;
+	bool held = false;
+
+	rcu_read_lock();
+	probe = rcu_dereference(mc16_storage_fixture);
+	if (probe && probe->task == current && probe->hold_segments &&
+	    func == mc16_segment_rcu_free) {
+		head->next = probe->delayed_segments;
+		probe->delayed_segments = head;
+		held = true;
+	}
+	rcu_read_unlock();
+	if (!held)
+		call_rcu(head, func);
+}
+
+static void mc16_test_drain_segments(struct mc16_storage_fixture *probe)
+{
+	struct rcu_head *head;
+
+	probe->hold_segments = false;
+	while ((head = probe->delayed_segments)) {
+		probe->delayed_segments = head->next;
+		call_rcu(head, mc16_segment_rcu_free);
+	}
+}
+
+static void *mc16_kunit_storage_alloc(size_t bytes, gfp_t gfp,
+				      struct obj_cgroup *objcg)
+{
+	struct mc16_storage_fixture *probe;
+	void (*window)(void *data) = NULL;
+	void *data = NULL, *ptr;
+	bool modeled = false, fail = false;
+#ifdef CONFIG_MEMCG
+	struct memcomp_kunit_objcg *model;
+#endif
+
+	rcu_read_lock();
+#ifdef CONFIG_MEMCG
+	model = rcu_dereference(memcomp_kunit_objcg);
+	modeled = model && objcg == &model->objcg;
+#endif
+	probe = rcu_dereference(mc16_storage_fixture);
+	if (probe && probe->task == current) {
+		probe->allocations++;
+		fail = probe->allocations == probe->fail_at ||
+			(probe->fail_descriptor &&
+			 bytes == sizeof(struct mc16_segment_retire));
+		window = probe->allocation_window;
+		data = probe->window_data;
+		probe->allocation_window = NULL;
+	}
+	rcu_read_unlock();
+	if (fail)
+		return NULL;
+	/* Synthetic objcg has no css: explicitly model only the allocator. */
+	ptr = modeled ? kmalloc(bytes, gfp & ~__GFP_ACCOUNT) :
+		mc16_kmalloc_owner(bytes, gfp, objcg);
+	if (window)
+		window(data);
+	return ptr;
+}
+#endif /* _MM_MEMCOMP_TESTS_STORAGE_FIXTURE_H */
diff --git a/mm/memcomp/tests/storage_test.h b/mm/memcomp/tests/storage_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..a3a03336d57c61af0c91fff79cec9b6328b26d9c
--- /dev/null
+++ b/mm/memcomp/tests/storage_test.h
@@ -0,0 +1,468 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_STORAGE_TEST_H
+#define _MM_MEMCOMP_TESTS_STORAGE_TEST_H
+
+/* Pressure cleanup is explicit; normal retirement keeps appendable headers. */
+static void mc16_test_reclaim_retained(void)
+{
+	struct shrink_control sc = { .nr_to_scan = 64 };
+	struct mc16_cluster *cluster;
+	unsigned long flags, id;
+	bool found;
+
+	cancel_delayed_work_sync(&mc16_retained_aging);
+	while (READ_ONCE(mc16_retained_empty_headers)) {
+		found = false;
+		xa_lock_irqsave(&mc16_clusters, flags);
+		xa_for_each(&mc16_clusters, id, cluster) {
+			if (xa_is_value(cluster) || xa_is_internal(cluster))
+				continue;
+			if (cluster->key->current_cluster != cluster ||
+			    cluster->live_slots || !cluster->next ||
+			    cluster->next >= MC16_CLUSTER_SLOTS ||
+			    cluster->eligible_slots || !list_empty(&cluster->fifo))
+				continue;
+			mc16_meta_shrinker_cursor = id;
+			found = true;
+			break;
+		}
+		xa_unlock_irqrestore(&mc16_clusters, flags);
+		/* An inconsistent count must not turn a failed test into a hang. */
+		if (WARN_ON_ONCE(!found))
+			break;
+		if (WARN_ON_ONCE(!mc16_meta_shrinker_scan(NULL, &sc)))
+			break;
+	}
