+static int mc16_zcar_refresh(struct mc16_test_zc *f, unsigned int pattern)
+{
+	struct folio *folio = f->refs->storage->owner->folio;
+	u8 *src;
+	unsigned int i;
+	int ret;
+
+	folio_lock(folio);
+	src = kmap_local_folio(folio, 0);
+	for (i = 0; i < PAGE_SIZE; i++)
+		src[i] = pattern == 256 ? i % 53 : pattern;
+	kunmap_local(src);
