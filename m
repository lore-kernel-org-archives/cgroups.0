+			before.pages[MC16_ZERO_CACHE_PUT], 1ULL);
+#endif
+	memcomp_invalidate(0);
+	memcomp_invalidate_cache(0);
+	memcomp_invalidate_cache(0);
+	mc16_test_zcall_counts(f, 0, 0);
+}
