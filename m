+	KUNIT_EXPECT_TRUE(test, mc16_zero_pte_init(0));
+	KUNIT_EXPECT_TRUE(test, mc16_zero_pte_get(0));
+	KUNIT_EXPECT_TRUE(test, mc16_zero_pte_put(0));
+	KUNIT_EXPECT_TRUE(test, mc16_zero_cache_get(0));
