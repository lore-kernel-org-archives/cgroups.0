+static bool mc16_zh_is_zero(unsigned int page)
+{
+	unsigned int i = page % 512;
+
+	/* Exactly 42 zeros/block; every unsegregated 64-slot segment has both. */
+	return ((i + 1) * 42 / 512) != (i * 42 / 512);
+}
