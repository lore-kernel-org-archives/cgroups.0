+	KUNIT_EXPECT_EQ(test, after.calls[MC16_ZERO_PTE_PUT] -
+			before.calls[MC16_ZERO_PTE_PUT], 2ULL);
+	KUNIT_EXPECT_EQ(test, after.pages[MC16_ZERO_PTE_PUT] -
+			before.pages[MC16_ZERO_PTE_PUT], 4ULL);
