+static void *mc16_defrag_test_buffer(void)
+{
+	if (mc16_defrag_test_current->fail_buffer)
+		return NULL;
+	return kmalloc(PAGE_SIZE, GFP_NOWAIT | __GFP_NOWARN);
+}
