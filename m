+	KUNIT_ASSERT_NOT_NULL(test, f->survivor[0].slot);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->survivor[0].slot->refs), 2U);
+	KUNIT_ASSERT_TRUE(test, mc16_get(token, &f->lookup));
