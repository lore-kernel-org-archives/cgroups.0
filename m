+	struct memcomp_store_ctx store = {};
+	unsigned int reclaim_flags;
+	unsigned int length;
+	unsigned long handle;
+	s64 reject_ge, fail;
+	u8 pool_idx;
+	const u8 *payload;
+	u8 *src;
+	int ret;
+
+	if (!memcomp_is_enabled()) {
+		kunit_skip(test, "memcomp initialization failed");
+		return;
+	}
