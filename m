+struct mc16_ws_test {
+	struct kunit *test;
+	struct mc16_flt *anon;
+	struct mem_cgroup *target;
+	struct mem_cgroup *seen_target;
+	struct folio *source;
+	struct completion start;
+	struct completion done;
+	struct task_struct *worker;
+	unsigned int calls;
+	unsigned int pages;
+	unsigned long native_before;
+	unsigned long native_after;
+	bool native_mglru;
+	bool locked;
+	bool isolated;
+	bool token_locks_free;
+	bool worker_done;
+	int source_refs;
+	int load[2];
+	bool writeback[2];
+	int zap[2];
+	u8 *buffer;
+	void *shadow;
+};
