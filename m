+	KUNIT_EXPECT_EQ(test, snapshot.samefill_pages, (s64)0);
+	KUNIT_EXPECT_EQ(test, snapshot.raw_pages, (s64)0);
+	KUNIT_EXPECT_EQ(test, snapshot.shmem_pages, (s64)5);
