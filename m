+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_ZERO_CALLERS_TEST_H
+#define _MM_MEMCOMP_TESTS_ZERO_CALLERS_TEST_H
