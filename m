+++ b/mm/memcomp/tests/budget_swapped_test.h
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_BUDGET_SWAPPED_TEST_H
+#define _MM_MEMCOMP_TESTS_BUDGET_SWAPPED_TEST_H
+
+/* Include after budget_test.h; only run serially in an isolated swap guest. */
+#if defined(MC16_FOLIO_TEST_ENABLED) && defined(CONFIG_SWAP)
+struct mc16_bw {
+	struct kunit *test;
+	struct mc16_bm *bm;
+	swp_entry_t swap[MC16_TEST_WORKERS];
+	struct swap_info_struct *device[MC16_TEST_WORKERS];
+	bool real;
+};
+
+static void mc16_bw_cleanup(void *data)
+{
+	struct mc16_bw *f = data;
+	unsigned int i;
+
+	/* Join workers, stop the budget, then remove ALL PTEs while puts are real. */
+	kunit_release_action(f->test, mc16_bm_cleanup, f->bm);
+	kunit_release_action(f->test, mc16_flt_cleanup, f->bm->seed);
+	/* All fixture PTEs are removed before real swap mode ends. */
+	mc16_test_reclaim_retained();
+	for (i = 0; i < MC16_TEST_WORKERS; i++) {
+		if (!f->device[i])
+			continue;
+		KUNIT_EXPECT_EQ(f->test, __swap_count(f->swap[i]), 0);
+		put_swap_device(f->device[i]);
+		f->device[i] = NULL;
+	}
+	if (f->real) {
+		KUNIT_EXPECT_TRUE(f->test, xa_empty(&mc16_clusters));
+		WRITE_ONCE(mc16_kunit_real_swap, false);
+		synchronize_rcu();
+		f->real = false;
+	}
+}
+
+static struct mc16_bw *mc16_bw_begin(struct kunit *test, unsigned int nr)
+{
+	struct mc16_bw *f;
+	bool idle;
+
+	if (get_nr_swap_pages() < nr) {
+		kunit_skip(test, "requires active real swap; rerun after guest swapon");
+		return NULL;
+	}
+	if (READ_ONCE(mc16_kunit_real_swap)) {
+		KUNIT_FAIL(test, "another real-swap fixture is active");
+		return NULL;
+	}
+	mutex_lock(&memcomp_writeback_lock);
+	idle = !mc16_writeback_batch_used && !mc16_writeback_members_used &&
+		!mc16_writeback_open_first && !mc16_writeback_open_bytes &&
+		!memcomp_writeback_slots_free && !memcomp_writeback_plugged;
+	mutex_unlock(&memcomp_writeback_lock);
+	if (!idle) {
+		KUNIT_FAIL(test, "writeback staging or reservation pool is not idle");
+		return NULL;
+	}
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->test = test;
+	f->bm = mc16_bm_begin(test, nr, false);
+	if (!f->bm)
+		return NULL;
+	if (kunit_add_action_or_reset(test, mc16_bw_cleanup, f))
+		return NULL;
+	f->real = true;
+	WRITE_ONCE(mc16_kunit_real_swap, true);
+	return f;
+}
+
+/* The real drain has one W scope and no empty final selector (limit is one). */
+static int mc16_bw_drain(struct mc16_flt *p)
+{
+	struct memcomp_lru *fifo = memcomp_lru_nid(folio_nid(p->folio));
+	unsigned long scanned, freed = 0;
+	unsigned int noreclaim;
+	bool attempted = false;
+	int ret = 0;
+
+	if (!fifo)
+		return -EINVAL;
+	noreclaim = memalloc_noreclaim_save();
+	mutex_lock(&memcomp_writeback_lock);
+	scanned = mc16_writeback_drain_queue(folio_nid(p->folio), fifo, 1,
+					     &freed, &ret, &attempted);
+	mutex_unlock(&memcomp_writeback_lock);
+	memalloc_noreclaim_restore(noreclaim);
+	return ret ? ret : scanned == 1 && attempted && freed == 1 ? 0 : -EIO;
+}
+
+/* Capture effective fields under T, then retain only a real swap-device pin. */
+static int mc16_bw_capture(struct mc16_bw *f, unsigned int index)
+{
+	struct mc16_flt *p = &f->bm->page[index];
+	struct memcomp_ref ref = { };
+	struct mc16_swap_fields fields;
+	struct mc16_view view;
+	unsigned long token;
+	bool valid;
+
+	/* Successful source release clears folio->swap: read the actual token PTE. */
+	{
+		pte_t pte = mc16_flt_read(f->bm->seed, p->addr);
+
+		if (!is_swap_pte(pte) || !is_memcomp_entry(pte_to_swp_entry(pte)))
+			return -EINVAL;
+		token = swp_offset(pte_to_swp_entry(pte));
+	}
+	if (!mc16_get(token, &ref))
+		return -ENOENT;
+	mutex_lock(memcomp_lock_of(token));
+	valid = mc16_view_locked(&ref, &view) && mc16_flags_valid(*view.flags) &&
+		mc16_flags_state(*view.flags) == MC16_SWAPPED &&
+		!(*view.flags & (MC16_F_OWNER | MC16_F_RESIDENT)) && !view.member &&
+		mc16_swap_decode(*view.word, *view.length, &fields) &&
+		!fields.packed && !fields.byte_offset && fields.length;
+	mutex_unlock(memcomp_lock_of(token));
+	mc16_ref_put(&ref);
+	if (!valid)
+		return -EIO;
+	f->swap[index] = swp_entry(fields.type, fields.swap_offset);
+	f->device[index] = get_swap_device(f->swap[index]);
+	if (!f->device[index])
+		return -ENODEV;
+	return __swap_count(f->swap[index]) == 1 ? 0 : -EIO;
+}
+
+static void mc16_bw_expect_idle(struct kunit *test)
+{
+	KUNIT_EXPECT_EQ(test, memcomp_writeback_slots_free, 0U);
+	KUNIT_EXPECT_EQ(test, mc16_writeback_batch_used, 0U);
+	KUNIT_EXPECT_EQ(test, mc16_writeback_members_used, 0U);
+}
+
+static int mc16_bw_prepare(struct mc16_bw *f, unsigned int index)
+{
+	int ret = mc16_bm_pageout(&f->bm->page[index]);
+
+	return ret ? ret : mc16_bw_drain(&f->bm->page[index]);
+}
+
+enum mc16_bw_op { MC16_BW_PAGEOUT, MC16_BW_REFAULT, MC16_BW_FORK, MC16_BW_EXIT };
+
+static void mc16_bw_one(struct kunit *test, enum mc16_bw_op op)
+{
+	struct mc16_bw *f = mc16_bw_begin(test, 1);
+	struct mc16_bm *bm;
+	bool unlocked = false;
+	vm_fault_t fault = 0;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	bm = f->bm;
+	if (op != MC16_BW_PAGEOUT) {
+		KUNIT_ASSERT_EQ(test, mc16_bw_prepare(f, 0), 0);
+		KUNIT_ASSERT_EQ(test, mc16_bw_capture(f, 0), 0);
+	}
+	switch (op) {
+	case MC16_BW_PAGEOUT:
+		ret = mc16_bw_prepare(f, 0);
+		break;
+	case MC16_BW_REFAULT:
+		fault = mc16_bm_fault(&bm->page[0], &unlocked);
+		ret = fault == VM_FAULT_NOPAGE ? 0 : -EIO;
+		break;
+	case MC16_BW_FORK:
+		ret = mc16_bm_pte(bm, bm->seed->addr + PAGE_SIZE, true);
+		break;
+	default:
+		ret = mc16_bm_pte(bm, bm->seed->addr, false);
+		break;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	switch (op) {
+	case MC16_BW_PAGEOUT:
+		KUNIT_ASSERT_EQ(test, mc16_bw_capture(f, 0), 0);
+				break;
+	case MC16_BW_REFAULT:
+		KUNIT_EXPECT_TRUE(test, unlocked);
+		mc16_bm_expect_bytes(test, bm, 0, false);
+		break;
+	case MC16_BW_FORK:
+		KUNIT_EXPECT_EQ(test, __swap_count(f->swap[0]), 1);
+		break;
+	default:
+		KUNIT_EXPECT_EQ(test, __swap_count(f->swap[0]), 0);
+		break;
+	}
+	mc16_bw_expect_idle(test);
+	kunit_release_action(test, mc16_bw_cleanup, f);
+}
+
+static void memcomp_test_budget_swapped_pageout(struct kunit *test)
+{
+	mc16_bw_one(test, MC16_BW_PAGEOUT);
+}
+
+static void memcomp_test_budget_swapped_refault1(struct kunit *test)
+{
+	mc16_bw_one(test, MC16_BW_REFAULT);
+}
+
+static void memcomp_test_budget_swapped_fork(struct kunit *test)
+{
+	mc16_bw_one(test, MC16_BW_FORK);
+}
+
+static void memcomp_test_budget_swapped_exit(struct kunit *test)
+{
+	mc16_bw_one(test, MC16_BW_EXIT);
+}
+
+static void memcomp_test_budget_swapped_refault4(struct kunit *test)
+{
+	struct mc16_bw *f = mc16_bw_begin(test, MC16_TEST_WORKERS);
+	struct mc16_bm *bm;
+	unsigned int i;
+	bool done = true;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	bm = f->bm;
+	for (i = 0; i < MC16_TEST_WORKERS; i++) {
+		struct mc16_bm_worker *w = &bm->worker[i];
+
+		/* Separate raw slots; setup is outside the refault measurement. */
+		KUNIT_ASSERT_EQ(test, mc16_bw_prepare(f, i), 0);
+		KUNIT_ASSERT_EQ(test, mc16_bw_capture(f, i), 0);
+		w->f = bm;
+		w->index = i;
+		init_completion(&w->ready);
+		init_completion(&w->done);
+		w->task = kthread_run(mc16_bm_worker, w, "mc16-swap-budget-%u", i);
+		if (IS_ERR(w->task)) {
+			w->task = NULL;
+			KUNIT_FAIL(test, "refault worker allocation failed");
+			return;
+		}
+		get_task_struct(w->task);
+		KUNIT_ASSERT_NE(test, wait_for_completion_timeout(&w->ready, HZ), 0UL);
+	}
+	complete_all(&bm->go);
+	for (i = 0; i < MC16_TEST_WORKERS; i++)
+		done &= !!wait_for_completion_timeout(&bm->worker[i].done, 10 * HZ);
+	if (!done) {
+		KUNIT_FAIL(test, "real swap fault timed out");
+		return;
+	}
+	for (i = 0; i < MC16_TEST_WORKERS; i++) {
+		KUNIT_EXPECT_EQ(test, (__force unsigned int)bm->worker[i].ret,
+				(__force unsigned int)VM_FAULT_NOPAGE);
+		KUNIT_EXPECT_TRUE(test, bm->worker[i].unlocked);
+		mc16_bm_expect_bytes(test, bm, i, false);
+		KUNIT_EXPECT_EQ(test, __swap_count(f->swap[i]), 0);
+	}
+	mc16_bw_expect_idle(test);
+	kunit_release_action(test, mc16_bw_cleanup, f);
+}
+
+/* A boot-time no-swap skip must not poison the later real-swap rerun. */
+static int mc16_bw_suite_init(struct kunit_suite *suite)
+{
+	struct kunit_case *test_case;
+
+	for (test_case = suite->test_cases; test_case->run_case; test_case++)
+		test_case->status = KUNIT_SUCCESS;
+	return 0;
+}
+
+/* This suite is deliberately excluded by the ordinary memcomp* filter. */
+static struct kunit_case mc16_bw_cases[] = {
+	KUNIT_CASE(memcomp_test_budget_swapped_pageout),
+	KUNIT_CASE(memcomp_test_budget_swapped_refault1),
+	KUNIT_CASE(memcomp_test_budget_swapped_refault4),
+	KUNIT_CASE(memcomp_test_budget_swapped_fork),
+	KUNIT_CASE(memcomp_test_budget_swapped_exit),
+	{ }
+};
+
+static struct kunit_suite mc16_bw_suite = {
+	.name = "swap-memcomp-budget",
+	.suite_init = mc16_bw_suite_init,
+	.test_cases = mc16_bw_cases,
+};
+
+kunit_test_suite(mc16_bw_suite);
+#endif /* MC16_FOLIO_TEST_ENABLED && CONFIG_SWAP */
+#endif /* _MM_MEMCOMP_TESTS_BUDGET_SWAPPED_TEST_H */
diff --git a/mm/memcomp/tests/budget_test.h b/mm/memcomp/tests/budget_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..02c77091520be197578bea05b08abe7a0f88e68c
--- /dev/null
+++ b/mm/memcomp/tests/budget_test.h
@@ -0,0 +1,542 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _MM_MEMCOMP_TESTS_BUDGET_TEST_H
+#define _MM_MEMCOMP_TESTS_BUDGET_TEST_H
+
+/* Include after folio_test.h. Public positive-token dispatch uses clustered slots. */
+#ifdef MC16_FOLIO_TEST_ENABLED
+#define MC16_TEST_WORKERS 4
+struct mc16_bm;
+struct mc16_bm_worker {
+	struct mc16_bm *f;
+	unsigned int index;
+	struct task_struct *task;
+	struct completion ready;
+	struct completion done;
+	vm_fault_t ret;
+	bool unlocked;
+};
+
+struct mc16_bm {
+	struct mc16_flt *seed;
+	struct mc16_flt page[4];
+	unsigned int nr;
+	struct completion go;
+	struct mc16_bm_worker worker[4];
+};
+
+/* Actual present/token PTE transaction; no lookup retained for assertions. */
+static int mc16_bm_pte(struct mc16_bm *f, unsigned long address, bool clone)
+{
+	struct mm_struct *mm = f->seed->mm;
+	unsigned long parent = f->seed->addr;
+	pte_t orig, *ptep, *child;
+	spinlock_t *ptl; /* Serializes the real PTE ownership transaction. */
+	pmd_t *pmd;
+	int ret = -ENOENT;
+
+	mmap_read_lock(mm);
+	pmd = mm_find_pmd(mm, clone ? parent : address);
+	if (!pmd)
+		goto out;
+	ptep = pte_offset_map_lock(mm, pmd, clone ? parent : address, &ptl);
+	if (!ptep)
+		goto out;
+	orig = ptep_get(ptep);
+	if (clone) {
+		/* Fixture child is adjacent, in this same prevalidated PTE table. */
+		child = ptep + 1;
+		if (address != parent + PAGE_SIZE ||
+		    (parent >> PMD_SHIFT) != (address >> PMD_SHIFT) ||
+		    !pte_none(ptep_get(child)) || !is_swap_pte(orig) ||
+		    !is_memcomp_entry(pte_to_swp_entry(orig))) {
+			ret = -EINVAL;
+		} else if (!memcomp_entry_get(swp_offset(pte_to_swp_entry(orig)))) {
+			ret = -ENOENT;
+		} else {
+			/* The parent PTL remains held across get and child publication. */
+			orig = pte_swp_clear_exclusive(orig);
+			set_pte_at(mm, parent, ptep, orig);
+			set_pte_at(mm, address, child, orig);
+			add_mm_counter(mm, MM_SWAPENTS, 1);
+			ret = 0;
+		}
+	} else {
+		ret = 0;
+		if (is_swap_pte(orig) && is_memcomp_entry(pte_to_swp_entry(orig))) {
+			ptep_get_and_clear(mm, address, ptep);
+			add_mm_counter(mm, MM_SWAPENTS, -1);
+			memcomp_invalidate(swp_offset(pte_to_swp_entry(orig)));
+		}
+	}
+	pte_unmap_unlock(ptep, ptl);
+out:
+	mmap_read_unlock(mm);
+	return ret;
+}
+
+static void mc16_bm_cleanup(void *data)
+{
+	struct mc16_bm *f = data;
+	unsigned int i;
+
+	complete_all(&f->go);
+	for (i = 0; i < ARRAY_SIZE(f->worker); i++) {
+		if (f->worker[i].task) {
+			kthread_stop(f->worker[i].task);
+			put_task_struct(f->worker[i].task);
+		}
+	}
+	/* The extra child branch lives inside the seed's existing mapping. */
+	mc16_bm_pte(f, f->seed->addr + PAGE_SIZE, false);
+	for (i = 1; i < f->nr; i++) {
+		struct mc16_flt *p = &f->page[i];
+
+		mc16_flt_zap(p, p->addr);
+		if (p->folio) {
+			folio_lock(p->folio);
+			memcomp_invalidate_folio(p->folio);
+			folio_unlock(p->folio);
+			mc16_test_dontneed(p->mm, p->addr, PAGE_SIZE);
+			lru_add_drain_all();
+			folio_put(p->folio);
+		}
+		if (p->anon_vma)
+			put_anon_vma(p->anon_vma);
+	}
+	f->seed->base->model.folio = f->seed->folio;
+}
+
+static struct mc16_bm *mc16_bm_begin(struct kunit *test, unsigned int nr,
+				     bool samefill)
+{
+	struct mc16_bm *f;
+	unsigned int i;
+
+	f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	if (!f)
+		return NULL;
+	f->seed = mc16_flt_begin(test, 0);
+	if (!f->seed)
+		return NULL;
+	init_completion(&f->go);
+	if (kunit_add_action_or_reset(test, mc16_bm_cleanup, f))
+		return NULL;
+	f->nr = 1;
+	f->page[0] = *f->seed;
+	for (i = 1; i < nr; i++) {
+		struct mc16_flt *p = &f->page[i];
+
+		p->test = test;
+		p->base = f->seed->base;
+		p->mm = f->seed->mm;
+		p->addr = f->seed->addr + i * PAGE_SIZE;
+		f->nr++;
+		if (mc16_flt_map(p, 0))
+			return NULL;
+	}
+	for (i = 0; i < nr; i++) {
+		u8 *data = kmap_local_folio(f->page[i].folio, 0);
+
+		memset(data, 0x51 + i, PAGE_SIZE);
+		if (!samefill)
+			data[17] ^= 0xff;
+		kunmap_local(data);
+	}
+	return f;
+}
+
+/* Reserve -> actual rmap/PTE replacement -> public store -> source OWNER drop. */
+static int mc16_bm_pageout(struct mc16_flt *p)
+{
+	struct memcomp_reclaim_ctx *ctx;
+	unsigned int flags;
+	bool reserved, stored, released = false;
+
+	p->base->model.folio = p->folio;
+	folio_lock(p->folio);
+	reserved = memcomp_reserve(p->folio);
+	folio_unlock(p->folio);
+	if (!reserved)
+		return -ENOMEM;
+	if (mc16_flt_escape(p, 0))
+		return -EINVAL;
+	lru_add_drain_all();
+	if (folio_test_lru(p->folio)) {
+		if (!folio_isolate_lru(p->folio))
+			return -EBUSY;
+		/* Model reclaim isolation, not migration: the source is inactive. */
+		folio_clear_active(p->folio);
+		folio_put(p->folio); /* Keep only the original fixture hold. */
+	}
+	flags = memcomp_test_reclaimer_enter();
+	folio_lock(p->folio);
+	ctx = memcomp_reclaim_ctx_get(1, MEMCOMP_RECLAIM_KSWAPD);
+	if (!ctx) {
+		folio_unlock(p->folio);
+		memcomp_test_reclaimer_exit(flags);
+		return -EBUSY;
+	}
+	stored = memcomp_store_after_unmap(p->folio, &ctx);
+	if (ctx)
+		memcomp_reclaim_ctx_put(ctx);
+	if (stored) {
+		released = memcomp_release_folio(p->folio);
+		/* Only keep the fixture's original physical folio alive. */
+		if (released)
+			folio_ref_unfreeze(p->folio, 1);
+	}
+	folio_unlock(p->folio);
+	memcomp_test_reclaimer_exit(flags);
+	return stored && released ? 0 : -EIO;
+}
+
+static vm_fault_t mc16_bm_fault(struct mc16_flt *p, bool *unlocked)
+{
+	struct vm_area_struct *vma;
+	vm_fault_t ret = VM_FAULT_SIGBUS;
+	bool locked = true;
+	pte_t orig;
+	pte_t *ptep;
+	spinlock_t *ptl; /* Serializes the real PTE ownership transaction. */
+	pmd_t *pmd;
+
+	*unlocked = false;
+	mmap_read_lock(p->mm);
+	vma = vma_lookup(p->mm, p->addr);
+	pmd = mm_find_pmd(p->mm, p->addr);
+	if (!vma || !pmd)
+		goto out;
+	ptep = pte_offset_map_lock(p->mm, pmd, p->addr, &ptl);
+	if (!ptep)
+		goto out;
+	orig = ptep_get(ptep);
+	pte_unmap_unlock(ptep, ptl);
+	{
+		struct vm_fault vmf = {
+			.vma = vma, .address = p->addr, .real_address = p->addr,
+			.flags = FAULT_FLAG_ORIG_PTE_VALID,
+			.pmd = pmd, .orig_pte = orig,
+			.gfp_mask = GFP_HIGHUSER_MOVABLE,
+		};
+
+		ret = memcomp_load(&vmf, &locked);
+		*unlocked = !locked && !vmf.pte;
+	}
+out:
+	mmap_read_unlock(p->mm);
+	return ret;
+}
+
+/* Pin the installed page under PTL; all oracle work follows measurement. */
+static void mc16_bm_expect_bytes(struct kunit *test, struct mc16_bm *f,
+				 unsigned int index, bool samefill)
+{
+	struct mm_struct *mm = f->seed->mm;
+	unsigned long address = f->page[index].addr;
+	struct page *page = NULL;
+	spinlock_t *ptl; /* Protects the PTE until the page pin is acquired. */
+	u8 *expected, *actual;
+	pte_t *ptep, pte;
+	pmd_t *pmd;
+	int different;
+
+	expected = kunit_kmalloc(test, PAGE_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, expected);
+	memset(expected, 0x51 + index, PAGE_SIZE);
+	if (!samefill)
+		expected[17] ^= 0xff;
+	mmap_read_lock(mm);
+	pmd = mm_find_pmd(mm, address);
+	if (!pmd)
+		goto out_unlock;
+	ptep = pte_offset_map_lock(mm, pmd, address, &ptl);
+	if (!ptep)
+		goto out_unlock;
+	pte = ptep_get(ptep);
+	if (pte_present(pte) && !pte_special(pte)) {
+		page = pte_page(pte);
+		get_page(page);
+	}
+	pte_unmap_unlock(ptep, ptl);
+out_unlock:
+	mmap_read_unlock(mm);
+	KUNIT_ASSERT_NOT_NULL(test, page);
+	actual = kmap_local_page(page);
+	different = memcmp(actual, expected, PAGE_SIZE);
+	kunmap_local(actual);
+	put_page(page);
+	KUNIT_EXPECT_EQ(test, different, 0);
+}
+
+/* Real PTE operations remain covered without operation-budget probes. */
+enum mc16_bm_op { MC16_BM_PAGEOUT, MC16_BM_REFAULT, MC16_BM_FORK, MC16_BM_EXIT };
+
+static void mc16_bm_one(struct kunit *test, enum mc16_bm_op op, bool samefill)
+{
+	struct mc16_bm *f = mc16_bm_begin(test, 1, samefill);
+	bool unlocked = false;
+	vm_fault_t fault = 0;
+	int ret;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	if (op != MC16_BM_PAGEOUT)
+		KUNIT_ASSERT_EQ(test, mc16_bm_pageout(&f->page[0]), 0);
+	switch (op) {
+	case MC16_BM_PAGEOUT:
+		ret = mc16_bm_pageout(&f->page[0]);
+		break;
+	case MC16_BM_REFAULT:
+		fault = mc16_bm_fault(&f->page[0], &unlocked);
+		ret = (fault & VM_FAULT_NOPAGE) && (fault & VM_FAULT_MAJOR) ?
+			0 : -EIO;
+		break;
+	case MC16_BM_FORK:
+		ret = mc16_bm_pte(f, f->seed->addr + PAGE_SIZE, true);
+		break;
+	default:
+		ret = mc16_bm_pte(f, f->seed->addr, false);
+		break;
+	}
+	KUNIT_ASSERT_EQ(test, ret, 0);
+	switch (op) {
+	case MC16_BM_PAGEOUT:
+		break;
+	case MC16_BM_REFAULT:
+		KUNIT_EXPECT_TRUE(test, unlocked);
+		KUNIT_EXPECT_TRUE(test, pte_present(mc16_flt_read(f->seed, f->seed->addr)));
+		mc16_bm_expect_bytes(test, f, 0, samefill);
+		/* Stable non-PENDING tags skip the resident actor T. */
+		break;
+	case MC16_BM_FORK:
+		break;
+	default:
+		break;
+	}
+}
+
+static int mc16_bm_worker(void *data)
+{
+	struct mc16_bm_worker *w = data;
+	struct mc16_flt *p = &w->f->page[w->index];
+
+	/* Keep deterministic work scheduling attached to the live parent test. */
+	current->kunit_test = p->test;
+	complete(&w->ready);
+	wait_for_completion(&w->f->go);
+	kthread_use_mm(p->mm);
+	w->ret = mc16_bm_fault(p, &w->unlocked);
+	kthread_unuse_mm(p->mm);
+	KUNIT_EXPECT_FALSE(p->test, delayed_work_pending(&mc16_retained_aging));
+	current->kunit_test = NULL;
+	complete(&w->done);
+	return 0;
+}
+
+static void mc16_bm_four(struct kunit *test, bool samefill)
+{
+	struct mc16_bm *f = mc16_bm_begin(test, 4, samefill);
+	unsigned int i;
+	bool ready = true;
+
+	KUNIT_ASSERT_NOT_NULL(test, f);
+	for (i = 0; i < 4; i++) {
+		struct mc16_bm_worker *w = &f->worker[i];
+
+		KUNIT_ASSERT_EQ(test, mc16_bm_pageout(&f->page[i]), 0);
+		w->f = f;
+		w->index = i;
+		init_completion(&w->ready);
+		init_completion(&w->done);
+		w->task = kthread_run(mc16_bm_worker, w, "mc16-budget-%u", i);
+		if (IS_ERR(w->task)) {
+			w->task = NULL;
+			KUNIT_FAIL(test, "refault worker allocation failed");
+			return;
+		}
+		get_task_struct(w->task);
+		ready &= !!wait_for_completion_timeout(&w->ready, HZ);
+	}
+	KUNIT_ASSERT_TRUE(test, ready);
+	complete_all(&f->go);
+	for (i = 0; i < 4; i++)
+		ready &= !!wait_for_completion_timeout(&f->worker[i].done, 10 * HZ);
+	if (!ready) {
+		KUNIT_FAIL(test, "refault worker timed out");
+		return;
+	}
+	for (i = 0; i < 4; i++) {
+		KUNIT_EXPECT_EQ(test, (__force unsigned int)f->worker[i].ret,
+				(__force unsigned int)(VM_FAULT_NOPAGE | VM_FAULT_MAJOR));
+		KUNIT_EXPECT_TRUE(test, f->worker[i].unlocked);
+		KUNIT_EXPECT_TRUE(test, pte_present(mc16_flt_read(f->seed,
+								  f->page[i].addr)));
+		mc16_bm_expect_bytes(test, f, i, samefill);
+	}
+}
