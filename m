+	KUNIT_EXPECT_EQ(test, refcount_read(&f->guard.slot->refs), 2U);
+	mc16_cache_abort(&f->guard);
+	mc16_cache_abort(&f->guard);
+	mc16_cache_commit(&f->guard);
+	KUNIT_EXPECT_EQ(test, refcount_read(&f->owners[0].slot->refs), 1U);
+}
