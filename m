+	KUNIT_ASSERT_EQ(test, mc16_zl_install(f, orig), 0);
+	ret = mc16_zl_fault(f, orig, 0);
+	KUNIT_ASSERT_EQ(test, (__force unsigned int)ret,
+			(__force unsigned int)VM_FAULT_NOPAGE);
